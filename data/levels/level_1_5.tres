[gd_resource type="Resource" script_class="LevelData" format=3]

[ext_resource type="Script" path="res://core/data/level_data.gd" id="1_level"]
[ext_resource type="Script" path="res://core/data/wave_data.gd" id="2_wave"]
[ext_resource type="Script" path="res://core/data/spawn_entry.gd" id="3_spawn"]
[ext_resource type="PackedScene" path="res://assets/backgrounds/crow_forest.tscn" id="4_bg"]
[ext_resource type="Resource" path="res://data/story/l5_before.tres" id="5_before"]
[ext_resource type="Resource" path="res://data/story/l5_after.tres" id="6_after"]

[sub_resource type="Resource" id="wave1_spawn1"]
script = ExtResource("3_spawn")
enemy_id = &"armored_husk"
count = 1
delay = 0.0
pattern = &"line_top"

[sub_resource type="Resource" id="wave1_spawn2"]
script = ExtResource("3_spawn")
enemy_id = &"crow"
count = 3
delay = 2.0
pattern = &"corners"

[sub_resource type="Resource" id="wave1_spawn3"]
script = ExtResource("3_spawn")
enemy_id = &"scarecrow_archer"
count = 2
delay = 7.0
pattern = &"edges"

[sub_resource type="Resource" id="wave1"]
script = ExtResource("2_wave")
spawns = Array[ExtResource("3_spawn")]([SubResource("wave1_spawn1"), SubResource("wave1_spawn2"), SubResource("wave1_spawn3")])

