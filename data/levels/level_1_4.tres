[gd_resource type="Resource" script_class="LevelData" format=3]

[ext_resource type="Script" path="res://core/data/level_data.gd" id="1_level"]
[ext_resource type="Script" path="res://core/data/wave_data.gd" id="2_wave"]
[ext_resource type="Script" path="res://core/data/spawn_entry.gd" id="3_spawn"]
[ext_resource type="PackedScene" path="res://assets/backgrounds/farm_fence.tscn" id="4_bg"]

[sub_resource type="Resource" id="wave1_spawn1"]
script = ExtResource("3_spawn")
enemy_id = &"scarecrow"
count = 5
delay = 0.5
pattern = &"surround"

[sub_resource type="Resource" id="wave1_spawn2"]
script = ExtResource("3_spawn")
enemy_id = &"scarecrow"
count = 4
delay = 9.0
pattern = &"edges"

[sub_resource type="Resource" id="wave1"]
script = ExtResource("2_wave")
spawns = Array[ExtResource("3_spawn")]([SubResource("wave1_spawn1"), SubResource("wave1_spawn2")])

[sub_resource type="Resource" id="wave2_spawn1"]
script = ExtResource("3_spawn")
enemy_id = &"scarecrow"
count = 6
delay = 0.0
pattern = &"surround"

[sub_resource type="Resource" id="wave2_spawn2"]
script = ExtResource("3_spawn")
enemy_id = &"crow"
count = 2
delay = 7.0
pattern = &"corners"

[sub_resource type="Resource" id="wave2_spawn3"]
script = ExtResource("3_spawn")
enemy_id = &"scarecrow"
count = 3
delay = 12.0
pattern = &"line_top"

[sub_resource type="Resource" id="wave2"]
script = ExtResource("2_wave")
spawns = Array[ExtResource("3_spawn")]([SubResource("wave2_spawn1"), SubResource("wave2_spawn2"), SubResource("wave2_spawn3")])

[sub_resource type="Resource" id="wave3_spawn1"]
script = ExtResource("3_spawn")
enemy_id = &"scarecrow"
count = 7
delay = 1.5
pattern = &"surround"

[sub_resource type="Resource" id="wave3_spawn2"]
script = ExtResource("3_spawn")
enemy_id = &"crow"
count = 2
delay = 5.0
pattern = &"corners"

[sub_resource type="Resource" id="wave3_spawn3"]
script = ExtResource("3_spawn")
enemy_id = &"scarecrow"
count = 6
delay = 9.0
pattern = &"surround"

[sub_resource type="Resource" id="wave3"]
script = ExtResource("2_wave")
spawns = Array[ExtResource("3_spawn")]([SubResource("wave3_spawn1"), SubResource("wave3_spawn2"), SubResource("wave3_spawn3")])

[resource]
script = ExtResource("1_level")
id = &"1-4"
display_name = "LEVEL_1_4"
waves = Array[ExtResource("2_wave")]([SubResource("wave1"), SubResource("wave2"), SubResource("wave3")])
is_boss = false
companions = Array[StringName]([&"bulldog"])
background = ExtResource("4_bg")
par_time = 62.0
damage_budget = 12
