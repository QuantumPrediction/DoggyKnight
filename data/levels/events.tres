desc = "EVENT_SWORD_GLOW_MORGANA_DESC"
icon = "res://assets/portraits/morgana/smirk.png"
tone = "morgana"
effects = {"stats": {"attack_damage": 0.3, "max_vigor": -0.2}}

[sub_resource type="Resource" id="sword_glow"]
script = ExtResource("2_event")
id = &"sword_glow"
title = "EVENT_SWORD_GLOW_TITLE"
options = Array[ExtResource("3_option")]([SubResource("sword_glow_merlin"), SubResource("sword_glow_morgana")])

