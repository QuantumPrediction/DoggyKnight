[gd_resource type="Resource" script_class="LevelEventTable" format=3]

[ext_resource type="Script" path="res://game/progression/level_event_table.gd" id="1_table"]
[ext_resource type="Script" path="res://game/progression/level_event.gd" id="2_event"]
[ext_resource type="Script" path="res://game/progression/event_option.gd" id="3_option"]

[sub_resource type="Resource" id="sword_glow_merlin"]
script = ExtResource("3_option")
title = "EVENT_SWORD_GLOW_MERLIN"
desc = "EVENT_SWORD_GLOW_MERLIN_DESC"
icon = "res://assets/portraits/merlin/proud.png"
tone = "merlin"
effects = {"heal_ratio": 1.0}

[sub_resource type="Resource" id="sword_glow_morgana"]
script = ExtResource("3_option")
