; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="金毛騎士"
config/version="0.1.0"
run/main_scene="res://game/flow/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/app_icon/icon.png"
boot_splash/bg_color=Color(0.435, 0.784, 0.941, 1)
boot_splash/image="res://assets/app_icon/splash.png"
boot_splash/stretch_mode=4
boot_splash/use_filter=false
config/quit_on_go_back=false
run/max_fps=60

[audio]

general/ios/session_category=0

[autoload]

EventBus="*res://core/event_bus.gd"
GameState="*res://core/game_state.gd"
AppLifecycle="*res://core/app_lifecycle.gd"
ScreenFit="*res://core/screen_fit.gd"
Sfx="*res://ui/audio/sfx.gd"
Music="*res://ui/audio/music.gd"
PlayLog="*res://platform/play_log.gd"

[display]

window/size/viewport_width=180
window/size/viewport_height=320
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"
window/handheld/orientation=1
window/vsync/vsync_mode=1
window/ios/allow_high_refresh_rate=false
window/ios/hide_status_bar=true
window/ios/hide_home_indicator=true
window/ios/suppress_ui_gesture=true

[gui]

theme/custom="res://ui/theme/main_theme.tres"

[input]

back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194305,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[input_devices]

pointing/emulate_touch_from_mouse=true

[internationalization]

locale/translations=PackedStringArray("res://i18n/strings.zh_TW.translation", "res://i18n/story.zh_TW.translation")
locale/fallback="zh_TW"

[layer_names]

2d_physics/layer_1="arena"
2d_physics/layer_2="player"
2d_physics/layer_3="companion"
2d_physics/layer_4="enemy"
2d_physics/layer_5="player_attack"
2d_physics/layer_6="enemy_attack"
2d_physics/layer_7="pickup"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
2d/snap/snap_2d_transforms_to_pixel=true
environment/defaults/default_clear_color=Color(0.18, 0.13, 0.22, 1)
